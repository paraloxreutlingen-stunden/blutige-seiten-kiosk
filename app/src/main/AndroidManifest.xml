<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fuer den eigenen Telefon-Dialer (direkter Anruf ohne System-Telefon-App) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Fuer das Senden der SMS an die Spielleitung, ohne die System-SMS-App zu oeffnen -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Fuer den eingebauten QR-Scanner (CameraX + ML Kit, laeuft in der eigenen App) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- Fuer das Laden der QR-Zielseite und das Code-Scanner-Modul von Google Play Services -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.BlutigeSeitenKiosk"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="false">

        <!-- excludeFromRecents: App taucht nicht in der Liste zuletzt genutzter Apps auf -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".CallActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true" />

        <activity
            android:name=".QrActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true" />

        <activity
            android:name=".WebViewActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true" />

        <!-- Video ist im Querformat gedreht (1920x1080) - eigener Bildschirm darf sich daher
             mitdrehen (sensorLandscape: dreht zwischen Quer- und umgekehrtem Querformat je nach
             Haltung, bleibt aber nie im Hochformat haengen) und laeuft im Vollbildmodus.
             configChanges verhindert, dass die Activity bei jeder Drehung neu startet und das
             Video von vorne beginnt. -->
        <activity
            android:name=".VideoActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:excludeFromRecents="true" />

        <activity
            android:name=".SmsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true" />

    </application>

</manifest>
