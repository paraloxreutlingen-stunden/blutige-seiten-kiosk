<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Fuer den eigenen Telefon-Dialer (direkter Anruf ohne System-Telefon-App) -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Fuer das Senden der SMS an die Spielleitung, ohne die System-SMS-App zu oeffnen -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Fuer den eingebauten QR-Scanner (CameraX + ML Kit, laeuft in der eigenen App) -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <!-- Fuer das Laden der QR-Zielseite und das Code-Scanner-Modul von Google Play Services -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Bildschirm aus, solange das Handy waehrend eines Anrufs am Ohr ist (Naeherungssensor) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.BlutigeSeitenKiosk"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="false">

        <!-- excludeFromRecents: App taucht nicht in der Liste zuletzt genutzter Apps auf -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Waehl-Bildschirm. Die DIAL-Intent-Filter sind Voraussetzung dafuer, dass Android
             die App als Standard-Telefon-App zulaesst. Eine mitgeschickte Nummer wird bewusst
             ignoriert - der Ziffernblock ist immer leer. -->
        <activity
            android:name=".CallActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.DIAL" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="tel" />
            </intent-filter>
        </activity>

        <!-- Eigener Anrufbildschirm (Tasten fuer das easybell-Menue, Lautsprecher, Auflegen) -->
        <activity
            android:name=".InCallActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:turnScreenOn="true" />

        <!-- Bekommt als Standard-Telefon-App alle Anrufe vom System (siehe KioskInCallService) -->
        <service
            android:name=".KioskInCallService"
            android:permission="android.permission.BIND_INCALL_SERVICE"
            android:exported="true">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true" />
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
        </service>

        <activity
            android:name=".QrActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true" />

        <activity
            android:name=".WebViewActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true" />

        <!-- Video ist im Querformat gedreht (1920x1080) - eigener Bildschirm darf sich daher
             mitdrehen (sensorLandscape: dreht zwischen Quer- und umgekehrtem Querformat je nach
             Haltung, bleibt aber nie im Hochformat haengen) und laeuft im Vollbildmodus.
             configChanges verhindert, dass die Activity bei jeder Drehung neu startet und das
             Video von vorne beginnt. -->
        <activity
            android:name=".VideoActivity"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:excludeFromRecents="true" />

        <activity
            android:name=".SmsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:excludeFromRecents="true" />

    </application>

</manifest>
