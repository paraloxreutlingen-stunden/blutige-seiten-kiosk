<?xml version="1.0" encoding="utf-8"?>
<!-- Eigener Anrufbildschirm. Gleiche Seitenraender und 3-Spalten-Raster wie
     activity_call.xml, damit Ziffernblock und Knoepfe an derselben Stelle sitzen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical">

    <!-- Nachgebaute Statusleiste: Uhrzeit, Empfang, WLAN, Akku (siehe StatusBarView) -->
    <de.paralox.kiosk.blutigeseiten.StatusBarView
        android:layout_width="match_parent"
        android:layout_height="28dp" />

    <Space android:layout_width="match_parent" android:layout_height="20dp" />

    <TextView
        android:id="@+id/numberDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:letterSpacing="0.05" />

    <TextView
        android:id="@+id/statusDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="#B0B0B0"
        android:textSize="16sp" />

    <!-- Hier erscheinen die waehrend des Anrufs gedrueckten Tasten (z. B. "1") -->
    <TextView
        android:id="@+id/dtmfDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:minHeight="32dp"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:letterSpacing="0.1" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/dialPad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical">
            <ImageButton
                android:id="@+id/btnSpeaker"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:padding="16dp"
                android:scaleType="fitCenter"
                android:background="@drawable/speaker_button_background"
                android:src="@drawable/ic_speaker"
                android:tint="@color/speaker_icon_tint"
                android:contentDescription="@string/cd_speaker" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical">
            <ImageButton
                android:id="@+id/btnHangUp"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:padding="18dp"
                android:scaleType="fitCenter"
                android:background="@drawable/hangup_button_background"
                android:src="@drawable/ic_call_end"
                android:contentDescription="@string/cd_hang_up" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

    </LinearLayout>

</LinearLayout>
