<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Hintergrundbild (Katzenfoto als "Hintergrundbild" wie bei einem echten Handy) -->
    <ImageView
        android:id="@+id/wallpaperImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/wallpaper_cat"
        android:contentDescription="@null" />

    <!-- Unten: Dock mit genau den vier echten Funktionen, keine zusaetzlichen
         Deko-Icons - nur, was im Spiel tatsaechlich gebraucht wird. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:background="@drawable/dock_background"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/btnCall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="22dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView style="@style/HomeIconBackground" android:backgroundTint="#34A853" android:src="@drawable/ic_call" android:contentDescription="@null"/>
            <TextView style="@style/HomeIconLabel" android:text="@string/home_call" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnSms"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="22dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView style="@style/HomeIconBackground" android:backgroundTint="#1A73E8" android:src="@drawable/ic_sms" android:contentDescription="@null"/>
            <TextView style="@style/HomeIconLabel" android:text="@string/home_sms" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnQr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginEnd="22dp"
            android:clickable="true"
            android:focusable="true">
            <ImageView style="@style/HomeIconBackground" android:backgroundTint="#424242" android:src="@drawable/ic_qr_scan" android:contentDescription="@null"/>
            <TextView style="@style/HomeIconLabel" android:text="@string/home_scanner" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnVideo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">
            <ImageView style="@style/HomeIconBackground" android:backgroundTint="#EA4335" android:src="@drawable/ic_video" android:contentDescription="@null"/>
            <TextView style="@style/HomeIconLabel" android:text="@string/home_video" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
