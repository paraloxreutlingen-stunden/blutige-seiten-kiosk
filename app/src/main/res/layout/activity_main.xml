<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Hintergrundbild (Katzenfoto als "Hintergrundbild" wie bei einem echten Handy) -->
    <ImageView
        android:id="@+id/wallpaperImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/wallpaper_cat"
        android:contentDescription="@null" />

    <!-- Sperrbildschirm-Optik oben: festes Datum (Spieldatum, aendert sich nie) ueber der
         echten, live laufenden Systemuhrzeit - wie auf einem normalen Sperrbildschirm.
         android:format12Hour/format24Hour gesetzt: TextClock uebernimmt automatisch die
         12h/24h-Einstellung des jeweiligen Geraets, genau wie ein echter Sperrbildschirm. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="64dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lockDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lock_screen_date"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:shadowColor="#AA000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="4" />

        <TextClock
            android:id="@+id/lockClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:textColor="#FFFFFF"
            android:textSize="64sp"
            android:fontFamily="sans-serif-light"
            android:shadowColor="#AA000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6" />

    </LinearLayout>

    <!-- Unten: Dock mit genau den vier echten Funktionen, keine zusaetzlichen
         Deko-Icons - nur, was im Spiel tatsaechlich gebraucht wird. -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:background="@drawable/dock_background"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/btnCall"
            style="@style/HomeIconBackground"
            android:layout_marginEnd="22dp"
            android:backgroundTint="#34A853"
            android:src="@drawable/ic_call"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/home_call" />

        <ImageView
            android:id="@+id/btnSms"
            style="@style/HomeIconBackground"
            android:layout_marginEnd="22dp"
            android:backgroundTint="#1A73E8"
            android:src="@drawable/ic_sms"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/home_sms" />

        <ImageView
            android:id="@+id/btnQr"
            style="@style/HomeIconBackground"
            android:layout_marginEnd="22dp"
            android:backgroundTint="#424242"
            android:src="@drawable/ic_qr_scan"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/home_scanner" />

        <ImageView
            android:id="@+id/btnVideo"
            style="@style/HomeIconBackground"
            android:backgroundTint="#EA4335"
            android:src="@drawable/ic_video"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/home_video" />

    </LinearLayout>

</FrameLayout>
