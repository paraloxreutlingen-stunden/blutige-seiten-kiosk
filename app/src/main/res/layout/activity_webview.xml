<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Nachgebaute Statusleiste: Uhrzeit, Empfang, WLAN, Akku (siehe StatusBarView) -->
    <de.paralox.kiosk.blutigeseiten.StatusBarView
        android:layout_width="match_parent"
        android:layout_height="28dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Bild-Ziel: zoombar (zwei Finger, Doppeltippen), dreht sich mit dem Handy -->
        <de.paralox.kiosk.blutigeseiten.ZoomImageView
            android:id="@+id/zoomImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:contentDescription="@null" />

        <!-- Webseiten-Ziel (Fallback, falls ein QR-Code mal auf eine Seite statt ein Bild zeigt) -->
        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <!-- Erscheint, wenn das Bild nicht geladen werden konnte (z. B. kein Internet) -->
        <ImageView
            android:id="@+id/errorIcon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_wifi_off"
            android:visibility="gone"
            android:contentDescription="@null" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/back_bar_background"
        android:scaleType="center"
        android:src="@drawable/ic_back"
        android:contentDescription="@string/back_to_menu" />

</LinearLayout>
