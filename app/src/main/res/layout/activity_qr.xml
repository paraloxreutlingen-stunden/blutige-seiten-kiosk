<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Nachgebaute Statusleiste: Uhrzeit, Empfang, WLAN, Akku (siehe StatusBarView) -->
    <de.paralox.kiosk.blutigeseiten.StatusBarView
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_gravity="top"
        android:background="#66000000" />

    <!-- Sucher-Rahmen statt Hinweistext (App ist bewusst textfrei, siehe QrFrameView) -->
    <de.paralox.kiosk.blutigeseiten.QrFrameView
        android:id="@+id/qrFrame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="56dp" />

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom"
        android:background="@drawable/back_bar_background"
        android:scaleType="center"
        android:src="@drawable/ic_back"
        android:contentDescription="@string/back_to_menu" />

</FrameLayout>
