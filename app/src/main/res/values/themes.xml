<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BlutigeSeitenKiosk" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
    </style>

    <!-- App-Icon auf dem nachgebauten Homescreen: abgerundetes, farbiges Quadrat -->
    <style name="HomeIconBackground">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:background">@drawable/icon_background</item>
        <item name="android:padding">14dp</item>
    </style>

    <!-- Grosse Ziffer im Dialer-Ziffernblock -->
    <style name="DialPadDigit">
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">26sp</item>
        <item name="android:gravity">center</item>
    </style>

    <!-- Kleine Buchstaben unter der Ziffer (z.B. "ABC" unter der 2) -->
    <style name="DialPadLetters">
        <item name="android:textColor">#9E9E9E</item>
        <item name="android:textSize">10sp</item>
        <item name="android:letterSpacing">0.15</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
